{
    "name": "nozugroup/ksef-client-php",
    "description": "Thin PHP wrapper client for the Polish KSeF 2.0 API.",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "endroid/qr-code": "^6.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nozu\\KsefClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nozu\\KsefClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
